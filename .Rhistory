#| fig-width: 8
#| fig-height: 9
#| out-width: "100%"
#| fig-dpi: 150
#| fig-cap: "Total Patent Count by Region (2008–2018 Averages)"
#| fig-subcap: "This map visualizes total patent activity across European regions, representing the volume of technological production and innovation output. The square root transformation compresses the scale to make the distribution more interpretable, as raw patent counts exhibit extreme skew (a few metropolitan regions produce thousands of patents while many rural regions produce tens). High-activity regions (bright yellow) are concentrated in major innovation hubs--Munich, Stuttgart, Paris, Milan, London, Stockholm-which dominate European patenting, while low-activity regions (dark blue) span large rural and peripheral territories. This map confirms that patenting is highly concentrated geographically, with the top 10% of regions accounting for the majority of European patent output, a pattern that motivates our analysis of how regions with different knowledge stocks face different diversification opportunities."
map_count <- targets::tar_read(map_count, store = here::here("../../_targets_DES"))
map_count +
scale_fill_viridis_c(
oob = scales::squish,
limits = c(10, 1000),
trans = scales::transform_sqrt(),
name = "Patent Count",
# labels = scales::label_log()
) +
theme(
plot.title = element_blank(),
# legend.position = "bottom",
# legend.direction = "horizontal",
# legend.box = "horizontal",
legend.title = element_text(hjust = 0.5, angle = 90),
legend.title.position = "right",
legend.key.width = unit(0.2, "cm"),
legend.key.height = unit(1, "null"),
# legend.box.just = "center",
legend.title.align = 0.5,
legend.margin = margin(t = 0, b = 0, r = 0.6, l = 0.6)
)
map_count
#| fig-width: 8
#| fig-height: 9
#| out-width: "100%"
#| fig-dpi: 150
#| fig-cap: "Total Patent Count by Region (2008–2018 Averages)"
#| fig-subcap: "This map visualizes total patent activity across European regions, representing the volume of technological production and innovation output. The square root transformation compresses the scale to make the distribution more interpretable, as raw patent counts exhibit extreme skew (a few metropolitan regions produce thousands of patents while many rural regions produce tens). High-activity regions (bright yellow) are concentrated in major innovation hubs--Munich, Stuttgart, Paris, Milan, London, Stockholm-which dominate European patenting, while low-activity regions (dark blue) span large rural and peripheral territories. This map confirms that patenting is highly concentrated geographically, with the top 10% of regions accounting for the majority of European patent output, a pattern that motivates our analysis of how regions with different knowledge stocks face different diversification opportunities."
