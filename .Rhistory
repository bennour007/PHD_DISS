#| tbl-cap: "Hypotheses, Variables, and Empirical Tests"
hypotheses <- tibble(
Hypothesis = c("H1", "H2a", "H2b", "H3a", "H3b", "H3c", "H4", "H5a", "H5b", "H5c"),
Claim = c(
"Potential is at least as informative as relatedness density in predicting entry",
"Technologies with a bridging role are positively associated with potential",
"Technologies with an enabling role are negatively associated with potential",
"Coherence positively predicts potential",
"Bridging technologies are more beneficial for low-coherence regions",
"The enabling technology penalty is smaller for high-coherence regions",
"National ecosystem characteristics shape potential beyond portfolio mechanisms",
"Regional potential is spatially interdependent across neighbouring regions",
"Bridging portfolio concentration predicts higher potential under sufficient coherence",
"Enabling portfolio concentration is positively associated with potential"
),
Key_variables = c(
"pred11 vs relatedness_density",
"betweenness",
"eigenvector",
"coherence",
"betweenness x coherence",
"eigenvector x coherence",
"GEI pillars x8-x14",
"Spatial lag (SAR)",
"avg_betweenness x avg_coherence",
"avg_eigenvector x avg_coherence"
),
Model = c(
"Model 0",
"Model 1",
"Model 1",
"Model 1",
"Model 1",
"Model 1",
"Model 2",
"Model 3",
"Model 3",
"Model 3"
)
)
